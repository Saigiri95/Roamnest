<% layout("layouts/boilerplate") %>

<div class="row">
  <div class="col-8 offset-2">

    <h3 class="mt-3">Create a New Listing</h3>

    <form method="POST" 
     action="/listings"
     novalidate class="needs-validation" 
     enctype="multipart/form-data">

      <div class="mb-3">
        <label class="form-label">Title</label>
        <input name="listing[title]" required 
          placeholder="add a catchy title"
          type="text" class="form-control">
          <div class="valid-feedback">Title looks good!</div>
      </div>
      

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="listing[description]"required
          class="form-control" ></textarea>
          <div class="invalid-feedback">please enter short description</div>
      </div>
      
      <div class="mb-3">
        <label class="form-label">Upload Listing image</label>
        <input name="listing[image]" 
          type="file" class="form-control" >
          required
          
      </div>


      <div class="row">
        <div class="mb-3 col-md-4">
          <label class="form-label">Price</label>
          <input name="listing[price]" required
             class="form-control" >
             <div class="invalid-feedback">Price should be valid</div>
        </div>
        

        <div class="mb-3 col-md-8">
          <label class="form-label">Country</label>
          <input name="listing[country]" required
            type="text" class="form-control" >
            <div class="invalid-feedback">country name !</div>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Location</label>
        <input name="listing[location]"
          type="text" class="form-control" >
          <div class="invalid-feedback">Location name </div>
      </div>

      <button class="btn btn-dark add-btn">Add</button>

    </form>

  </div>

</div>
