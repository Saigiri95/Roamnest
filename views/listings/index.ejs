  </div>

  <div class="filter">
    <div>
      <i class="fa-solid fa-water-ladder"></i>
    </div>
    <p>Pools</p>
  </div>

 

  <div class="filter">
    <div>
      <i class="fa-solid fa-snowflake"></i>
    </div>
    <p>Arctic</p>
  </div>

  <div class="filter">
    <div>
      <i class="fa-solid fa-campground"></i>
    </div>
    <p>Camping</p>
  </div>

  <div class="filter">
    <div>
      <i class="fa-solid fa-tree"></i>
    </div>
